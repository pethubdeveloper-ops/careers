{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/types.ts", "../src/lib/*.ts", "../src/data/*.ts"],
  "exclude": ["node_modules"]
}
